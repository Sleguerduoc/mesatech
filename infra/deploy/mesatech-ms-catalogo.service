[Unit]
Description=MesaTech Cloud - ms-catalogo
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mesatech
# Variables y credenciales fuera del repositorio
EnvironmentFile=/etc/mesatech/ms-catalogo.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/mesatech/ms-catalogo.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
