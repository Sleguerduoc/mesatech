# Copiar a .env (cp .env.example .env), reemplazar los valores y dejarlo con permisos 600.
# El archivo .env real nunca se sube al repositorio.
RABBITMQ_ADMIN_USER=mesatech_admin
RABBITMQ_ADMIN_PASSWORD=cambiar-admin-ficticio

# Usuarios de aplicacion (los usa configurar-rabbitmq.sh)
RABBITMQ_PUBLICADOR_USER=mesatech_publicador
RABBITMQ_PUBLICADOR_PASSWORD=cambiar-publicador-ficticio
RABBITMQ_CONSUMIDOR_USER=mesatech_consumidor
RABBITMQ_CONSUMIDOR_PASSWORD=cambiar-consumidor-ficticio
